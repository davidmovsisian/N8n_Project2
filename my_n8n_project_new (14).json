      ],
      "id": "b44f4657-e080-49f4-88f1-19a5822c394f",
      "name": "Extract content"
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const raw = $('Analyze document').first().json.output;\n  const parsed = JSON.parse(raw);\n  const html = parsed.text;\n  const filename = $('Configure').first().json['output file name'] || 'output.html';\n  const buffer = Buffer.from(html, 'utf8');\n  item.binary = item.binary || {};\n  item.binary.data = await this.helpers.prepareBinaryData(\n    buffer,\n    filename,\n    'text/html'\n  );\n}\n\nreturn $input.all();"
      },
