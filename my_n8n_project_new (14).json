      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import fitz\nimport docx\n\nfilename = f'/home/node/incoming_docs/{_items[0][\"json\"][\"input file name\"]}'\next = filename.rsplit('.', 1)[-1].lower()\n\nif ext == 'txt':\n    with open(filename, 'r', encoding='utf-8') as f:\n        content = f.read()\n\nelif ext == 'docx':\n    doc = docx.Document(filename)\n    content = '\\n'.join(p.text.strip() for p in doc.paragraphs)\n\nelif ext == 'pdf':\n    pdf = fitz.open(filename)\n    content = '\\n'.join(page.get_text() for page in pdf)\n  \n_items[0][\"json\"][\"text\"] = content\n  \nreturn _items"
      },
