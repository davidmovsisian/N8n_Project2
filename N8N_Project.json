    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following extracted text from a financial report and provide a structured JSON response. Do not include any markdown formatting, preamble, or postscript. Return ONLY the raw JSON object.\n\nRequirements:\n- company: full company name\n- classification: financial document type\n- summary: concise, maximum 200 characters\n- entities.people: list of key executives mentioned\n- entities.monetary_values: financial figures mentioned. list of objects with keys label -> Description of the line item (e.g., Total net sales), value -> Amount with currency symbol\n- entities.geographic_sales: list of sales per region, key -> region, value -> sales per region\n- entities.financial_ratios: list of financial ratios calculated from the financial statements(e.g., Net Profit Margin, Current Ratio, Debt-to-Equity). key -> name of financial ratio, value -> percentage or ratio value\n- sentiment.score: Positive, Neutral, or Negative\n- sentiment.rationale: concise, maximum 200 characters\n- action_items: exactly 3 concise items\n\nOutput JSON Schema:\n{\n  \"company\": \"string\",\n  \"classification\": \"string\",\n  \"summary\": \"string\",\n  \"entities\": {\n    \"people\": [\"string\"],\n    \"monetary_values\": [\n      {\n        \"label\": \"string\",\n        \"value\": \"string\"\n      }\n    ],\n    \"geographic_sales\":[\n      {\n        \"region\": \"string\",\n        \"sales\": \"string\"\n      }\n    ],\n    \"financial_ratios\":[\n      {\n        \"ratio\": \"string\",\n        \"value\": \"string\"\n      }\n    ]\n  },\n  \"sentiment\": {\n    \"score\": \"string\",\n    \"rationale\": \"string\"\n  },\n  \"action_items\": [\"string\"]\n}\n\nText:\n{{ $json.guardrailsInput }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert financial document extraction system. Be concise and follow the provided output schema exactly.\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        280,
        508
      ],
