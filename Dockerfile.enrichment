FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY src/enrichment_service.py /app/src/enrichment_service.py
COPY src/__init__.py /app/src/__init__.py
COPY src/templates /app/src/templates
RUN mkdir -p /home/node/incoming_docs

ENV INCOMING_DOCS_DIR=/home/node/incoming_docs

EXPOSE 8000

CMD ["python", "src/enrichment_service.py"]
